# Working exports. All of this is regenerated by `python src/make.py`.
# The panels are ~74 MB of composited JPEGs and the PDF is tens of MB, so
# neither belongs in the repository.
build/panels/
# Every intermediate PDF the build writes. pass1 is the digital edition's
# first numbering pass, kdp1 the print edition's; both are ~95 MB.
build/*.pdf
dist/
build/preview/

# The module copies the 168 cut-outs out of art/ at build time. No point
# keeping a second copy of them in the repository.
foundry/axes-and-aces-monsters/art/

# Trimmed copies of the brand art, remade on every build from img/ and icons/.
build/brand/

# The release zip, rebuilt by src/foundry.py and attached to a GitHub
# release rather than kept in the repository.
foundry/*.zip
